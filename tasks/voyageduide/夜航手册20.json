    "夜航20超时时间": {
      "type": "input",
      "inputs": [
        {
          "name": "超时时间",
          "description": "单位为秒，请合理配置",
          "default": "180",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航20-超时计时开始": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        }
      }
    },
    "夜航20刷取次数": {
      "type": "input",
      "inputs": [
        {
          "name": "刷取次数",
          "description": "配置为0即为无限刷取（或者你可以配置一个很大的数）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航20-计数检查": {
          "custom_action_param": {
            "id": "all",
            "target": "{刷取次数}"
          }
        }
      }
    },
    "夜航20主控": {
      "label": "主控",
      "type": "select",
      "default_case": "黎瑟",
      "cases": [
        {
          "name": "黎瑟",
          "pipeline_override": {
            "夜航20-角色主控": {
              "custom_action_param": "黎瑟"
            }
          },
          "option": [
            "夜航20黎瑟技能释放间隔"
          ]
        },
        {
          "name": "水母",
          "pipeline_override": {
            "夜航20-角色主控": {
              "custom_action_param": "水母"
            }
          },
          "option": [
            "夜航20水母技能释放间隔"
          ]
        }
      ]
    },
    "夜航20黎瑟技能释放间隔": {
      "label": "黎瑟技能释放间隔（Q技能）",
      "type": "input",
      "inputs": [
        {
          "name": "黎瑟技能释放间隔",
          "description": "单位为秒，请合理配置",
          "default": "20",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|1[0-9]|20)$"
        }
      ],
      "pipeline_override": {
        "夜航20-TextWatcher": {
          "time": "{黎瑟技能释放间隔}"
        }
      }
    },
