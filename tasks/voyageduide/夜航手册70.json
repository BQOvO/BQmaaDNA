    "夜航70超时时间": {
      "type": "input",
      "inputs": [
        {
          "name": "超时时间",
          "description": "单位为秒，请合理配置",
          "default": "180",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航70-超时计时开始": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        }
      }
    },
    "夜航70刷取次数": {
      "type": "input",
      "inputs": [
