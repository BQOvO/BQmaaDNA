          "name": "刷取次数",
          "description": "配置为0即为无限刷取（或者你可以配置一个很大的数）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航70-计数检查": {
          "custom_action_param": {
            "id": "all",
            "target": "{刷取次数}"
          }
        }
