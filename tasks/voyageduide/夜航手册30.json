              ]
            }
          },
          "option": [
            "夜航30轮次选择"
          ]
        },
        {
          "name": "第三个（枯萎 游击秽兽）",
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-3"
            },
            "夜航30-检测是否成功进入副本": {
              "expected": [
                "扼守"
              ]
            },
            "夜航30-结束计时": {
              "next": [
                "夜航30-轮次+1"
              ]
            }
          },
          "option": [
            "夜航30轮次选择"
          ]
        },
        {
          "name": "第四个（凛霜 疾冲秽兽）",
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-4"
            },
            "夜航30-检测是否成功进入副本": {
