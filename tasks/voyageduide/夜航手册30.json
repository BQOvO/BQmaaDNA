{
  "task": [
    {
      "name": "夜航手册30",
      "entry": "夜航30-启动",
      "description": "【夜航手册】\n\n1.在执行其他任务前可以先执行一下自动调设置任务，确保游戏为挂机所需的设置\n\n2.请合理配置超时时间\n\n3.请不要在任务执行过程中手动操作",
      "option": [
        "夜航30副本选择",
        "夜航30加成书选择",
        "夜航30主控",
        "夜航30刷取次数",
        "夜航30超时时间"
      ]
    }
  ],
  "option": {
    "夜航30副本选择": {
      "label": "副本选择",
      "type": "select",
      "default_case": "第一个（残火 暴徒秽兽）",
      "description": "选择第几个副本进行刷取",
      "cases": [
        {
          "name": "第一个（残火 暴徒秽兽）",
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-1"
            },
            "夜航30-检测是否成功进入副本": {
              "expected": [
                "扼守"
              ]
            },
            "夜航30-结束计时": {
              "next": [
                "夜航30-轮次+1"
              ]
            }
          },
          "option": [
            "夜航30轮次选择"
          ]
        },
        {
          "name": "第二个（霹雳 疾冲秽兽）",
          "pipeline_override": {
