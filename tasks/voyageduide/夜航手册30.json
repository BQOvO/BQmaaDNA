    "夜航30加成书选择": {
      "label": "加成书选择",
      "type": "select",
      "description": "选择加成书",
      "default_case": "不加成",
      "cases": [
        {
          "name": "不加成",
          "icon": "./resource/image/加成书/不加成.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "不选书"
            },
            "再次进行选书": {
              "custom_action_param": "不选书"
            },
            "夜航30-轮次选书": {
              "custom_action_param": "不选书"
            }
          }
        },
        {
          "name": "绿书（1倍）",
          "icon": "./resource/image/加成书/绿书.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "绿书"
            },
            "再次进行选书": {
              "custom_action_param": "绿书"
            },
            "夜航30-轮次选书": {
              "custom_action_param": "绿书"
            }
          }
        },
        {
          "name": "蓝书（2倍）",
          "icon": "./resource/image/加成书/蓝书.png",
